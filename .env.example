# Copy this file to .env and fill in your values.

PORT=3000

# Optional but recommended: protects wallet add/remove + manual scan endpoints.
# Leave blank only for quick local testing.
DASHBOARD_SECRET=change_me_to_something_random

# Telegram alerts (leave both blank to skip Telegram)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Discord alerts (separate destinations by alert type)
DISCORD_NFT_WEBHOOK=
DISCORD_TOKEN_WEBHOOK=

# Explorer API keys, comma-separated for multi-RPC failover.
# Robinhood and Ink are Blockscout explorers and don't need a key.
ETH_KEYS=key1,key2,key3

# Blockscout Pro API key for Robinhood Chain (free key from dev.blockscout.com).\nBLOCKSCOUT_API_KEY=\n\n# Token scanner RPC failover (Alchemy API keys, comma-separated).
# ETH_KEYS is reused for Ethereum token RPC failover.
# For Robinhood token RPC, create Robinhood Chain Alchemy apps and put their keys here.
ROBINHOOD_KEYS=

ARC_KEYS=key1

# Token tracking
ETH_TOKEN_TRACKING_ENABLED=false
ROBINHOOD_TOKEN_TRACKING_ENABLED=false
